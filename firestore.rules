rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // In this environment we check for sign-in, but prefer email_verified for production
      return isSignedIn();
    }

    // Check if the user is a bootstrap admin
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'saigoutham700@gmail.com';
    }

    // Check if the user is an admin via the admins collection or bootstrap
    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. User Profiles
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == userId &&
               data.email is string &&
               data.role in ['admin', 'staff'];
      }

      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      // Users cannot change their own role
      allow update: if isSignedIn() && request.auth.uid == userId && 
                    !incoming().diff(existing()).affectedKeys().hasAny(['role']) &&
                    isValidUser(incoming());
      allow delete: if isAdmin();
    }

    // 2. Admin List
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow write: if isBootstrapAdmin();
    }

    // 3. Products
    match /products/{productId} {
      function isValidProduct(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
               data.brand is string && data.model is string &&
               data.quantity is number && data.quantity >= 0 &&
               data.warehouseId is string;
      }

      allow list, get: if isSignedIn();
      allow create: if isAdmin() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isSignedIn() && (
        isAdmin() || 
        // Staff can update quantity and timestamps only
        (incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'updatedAt', 'status']) && 
         isValidProduct(incoming()))
      );
      allow delete: if isAdmin();
    }

    // 4. Warehouses
    match /warehouses/{warehouseId} {
      function isValidWarehouse(data) {
        return data.name is string && data.name.size() > 0 &&
               data.location is string;
      }

      allow list, get: if isSignedIn();
      allow write: if isAdmin() && isValidWarehouse(incoming()) && isValidId(warehouseId);
    }

    // 5. Transactions
    match /transactions/{transactionId} {
      function isValidTransaction(data) {
        return data.productId is string &&
               data.type in ['inflow', 'outflow', 'transfer'] &&
               data.quantity is number && data.quantity > 0 &&
               data.timestamp == request.time;
      }

      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidTransaction(incoming()) && isValidId(transactionId);
      allow update, delete: if false; // Transactions are immutable
    }

    // Connectivity Test
    match /test/connection {
      allow read: if true;
    }
  }
}
